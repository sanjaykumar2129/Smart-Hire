# Smart Hire AI - Environment Configuration
# Copy this file to .env to configure cloud Supabase integration

# Supabase Credentials (Optional - App runs in local persistence mode by default)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# AI Enhancement API Key (Optional - Native NLP Engine is active out of the box)
VITE_AI_API_KEY=
